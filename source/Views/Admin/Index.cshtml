@model DashboardViewModel
@{ ViewData["Title"] = "Admin"; }
<div class="panel">
  <partial name="_AdminNav" />
  <div class="stats">
    <div class="stat"><b>@Model.ActiveUsers</b><span>Active users (last 15 min)</span></div>
    <div class="stat"><b>@Model.Locs.Count(x => x.Status?.State == "up")/@Model.Locs.Count</b><span>Locations up</span></div>
    <div class="stat"><b>@Model.Failed24h</b><span>Failed sign-ins (24h)</span></div>
    <div class="stat"><b>@Model.UploadsToday</b><span>Uploads today</span></div>
    <div class="stat"><b>@Model.DownloadsToday</b><span>Downloads today</span></div>
  </div>
  <h3>Server status</h3>
  <div class="scroll"><table>
    <thead><tr><th>Location</th><th>Status</th><th>Targets up</th><th>24h uptime</th><th>Response</th></tr></thead>
    <tbody>
    @foreach (var (l, s) in Model.Locs)
    {
      <tr>
        <td><b>@l.Name</b> <span class="muted">@l.Domain</span></td>
        <td><span class="st @(s?.State ?? "")"><i class="dot"></i><em>@(s == null ? "n/a" : s.State == "up" ? "Up" : s.State == "degraded" ? "Degraded" : "Down")</em></span></td>
        <td>@(s == null ? "-" : s.UpCount + " of " + s.Total)</td>
        <td>@(s == null ? "-" : s.UptimePct + " %")</td>
        <td>@(s == null || s.State == "down" ? "-" : s.Ms + " ms")</td>
      </tr>
    }
    </tbody>
  </table></div>
  <h3>Recent activity</h3>
  <div class="scroll"><table>
    <thead><tr><th>Time (UTC)</th><th>Event</th><th>User</th><th>Detail</th></tr></thead>
    <tbody>
    @foreach (var e in Model.Recent)
    {
      <tr><td class="muted">@e.Time.ToString("MM-dd HH:mm:ss")</td><td class="@(e.Ok ? "" : "bad-t")">@e.Type</td><td>@e.User</td><td class="muted">@e.Detail</td></tr>
    }
    </tbody>
  </table></div>
</div>
